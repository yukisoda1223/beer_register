# このファイルをコピーして .env.local を作り、= の右側に値を入れてください。
# .env.local は Git に含めません(秘密情報なので絶対にコミットしない)。
# 書き方: = の前後にスペースを入れない。値を " " で囲まなくてよい。

# ===== Supabase(マイルストーン2)=====
# Project URL(例: https://abcdefghijklmnop.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key(sb_publishable_ で始まる)。古い画面なら「anon public」のキーでも可
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key(sb_secret_ で始まる)。M2ではまだ使わないので空のままでOK
SUPABASE_SECRET_KEY=
# アプリにログインする自分の Gmail
ALLOWED_EMAIL=

# ===== Claude API(マイルストーン4)=====
# platform.claude.com の API Keys で作ったキー(sk-ant- で始まる)
ANTHROPIC_API_KEY=
# 使うモデル。高すぎると感じたら claude-haiku-4-5 などに変えられる
ANTHROPIC_MODEL=claude-sonnet-5-5
# 1日にAIを呼べる上限回数(日本時間の0時にリセット)
AI_DAILY_LIMIT=50

# ===== 地図(マイルストーン6)=====
# 住所→緯度経度に使う OpenStreetMap Nominatim の決まりで、連絡先を書く(例: beer_register (自分のメール))
NOMINATIM_USER_AGENT=beer_register
