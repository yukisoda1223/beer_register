# このファイルをコピーして .env.local を作り、値を入れてください。
# .env.local は Git に含めません(秘密情報なので絶対にコミットしない)。

# --- Supabase(マイルストーン2)---
# Supabase の Project Settings → API Keys で確認
NEXT_PUBLIC_SUPABASE_URL=            # 例: https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY= # 「Publishable key」(sb_publishable_ で始まる)。古い画面なら「anon public」のキーでも可
SUPABASE_SECRET_KEY=                 # 「Secret key」(sb_secret_ で始まる)。サーバー側のみ。M2ではまだ使わないので空でOK
ALLOWED_EMAIL=                       # ログインを許可するGoogleアカウントのメールアドレス

# --- Claude API(マイルストーン4)---
ANTHROPIC_API_KEY=                   # サーバー側のみで使用
ANTHROPIC_MODEL=                     # 使うClaudeのモデルID。docs.claude.com で確認して設定
AI_DAILY_LIMIT=50                    # 1日にAIを呼べる上限回数

# --- 地図(マイルストーン6)---
NOMINATIM_USER_AGENT=beer_register (連絡先メール)
